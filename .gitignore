# ---------------------------------------------------------------
.vs/
*.user
*.suo
*.userprefs
*.rsuser
*.DotSettings.user
.idea/
*.sln.iml
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ---------------------------------------------------------------
# AI assistant local settings (shared config stays tracked)
# ---------------------------------------------------------------
.claude/settings.local.json
# One-off task prompts; keep local only
.claude/prompts/

