# Copy to .env and fill in. Never commit .env.

# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# SQLite file. The Docker image defaults to /data/leaguescout.db (mount a volume at /data).
DATABASE_PATH=/data/leaguescout.db

# How often cached events are posted to servers (TimeSpan, hh:mm:ss). Minimum 00:05:00. Default 06:00:00.
# This does not contact PokéData. PokéData is polled once per shared dataset every PokeData__RefreshInterval
# (default 06:00:00); see README "How PokéData is polled" for all PokeData__* settings.
# PokeData__RefreshInterval=06:00:00
EVENT_SYNC_INTERVAL=06:00:00

# Optional: register slash commands to one server only (instant updates during development).
# Leave empty to register globally.
DISCORD_COMMAND_GUILD_ID=
